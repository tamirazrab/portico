POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASS=example
POSTGRES_DB=nextbp

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

